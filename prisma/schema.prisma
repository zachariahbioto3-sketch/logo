generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  defaultModel String    @default("gemini-3.6-flash")
  studyField   String?

  companies         Company[]
  projects          Project[]
  chats             Chat[]
  tasks             Task[]
  agents            Agent[]
  memberships       GroupMembership[]
  groupPosts        GroupPost[]
  groupPostLikes    GroupPostLike[]
  groupPostComments GroupPostComment[]
}

model Company {
  id        String    @id @default(cuid())
  name      String
  joinCode  String    @unique
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  projects  Project[]
  members   GroupMembership[]
  posts     GroupPost[]
  createdAt DateTime  @default(now())
}

model GroupMembership {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  group    Company  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
}

model GroupPost {
  id        String   @id @default(cuid())
  group     Company  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  likes    GroupPostLike[]
  comments GroupPostComment[]
}

model GroupPostLike {
  id        String   @id @default(cuid())
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model GroupPostComment {
  id        String   @id @default(cuid())
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime  @default(now())
}

model Project {
  id        String    @id @default(cuid())
  name      String
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  company   Company?  @relation(fields: [companyId], references: [id])
  companyId String?
  chats     Chat[]
  tasks     Task[]
  createdAt DateTime  @default(now())
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  systemPrompt String
  defaultModel String
  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      String
  chats        Chat[]
  createdAt    DateTime @default(now())
}

model Chat {
  id        String    @id @default(cuid())
  title     String    @default("New chat")
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
  agent     Agent?    @relation(fields: [agentId], references: [id])
  agentId   String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String   @id @default(cuid())
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId         String
  role           String
  content        String
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  createdAt      DateTime @default(now())
}

model Task {
  id        String    @id @default(cuid())
  title     String
  status    String    @default("todo")
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
  createdAt DateTime  @default(now())
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  model     String
  createdAt DateTime @default(now())
}
