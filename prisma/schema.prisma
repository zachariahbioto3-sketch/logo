generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  defaultModel String    @default("gemini-2.0-flash")
  studyField   String?

  companies         Company[]
  projects          Project[]
  chats             Chat[]
  tasks             Task[]
  agents            Agent[]
  memberships       GroupMembership[]
  groupPosts        GroupPost[]
  groupPostLikes    GroupPostLike[]
  groupPostComments GroupPostComment[]
  decks             Deck[]
  settings          UserSettings?
}

model Company {
  id        String    @id @default(cuid())
  name      String
  joinCode  String    @unique
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  projects  Project[]
  members   GroupMembership[]
  posts     GroupPost[]
  agents    Agent[]
  createdAt DateTime  @default(now())
}

model GroupMembership {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  group    Company  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
}

model GroupPost {
  id        String   @id @default(cuid())
  group     Company  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())

  likes    GroupPostLike[]
  comments GroupPostComment[]
}

model GroupPostLike {
  id        String   @id @default(cuid())
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model GroupPostComment {
  id        String   @id @default(cuid())
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime  @default(now())
}

model Project {
  id        String    @id @default(cuid())
  name      String
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  company   Company?  @relation(fields: [companyId], references: [id])
  companyId String?
  chats     Chat[]
  tasks     Task[]
  createdAt DateTime  @default(now())
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  systemPrompt String
  defaultModel String
  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      String
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  chats        Chat[]
  createdAt    DateTime @default(now())
}

model Chat {
  id        String    @id @default(cuid())
  title     String    @default("New chat")
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
  agent     Agent?    @relation(fields: [agentId], references: [id])
  agentId   String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String   @id @default(cuid())
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId         String
  role           String
  content        String
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  createdAt      DateTime @default(now())
}

model Task {
  id        String    @id @default(cuid())
  title     String
  status    String    @default("todo")
  owner     User      @relation(fields: [ownerId], references: [id])
  ownerId   String
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
  createdAt DateTime  @default(now())
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  model     String
  createdAt DateTime @default(now())
}
model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                 String   @default("light")
  fontSize              String   @default("medium")
  compactView           Boolean  @default(false)
  streamResponses       Boolean  @default(true)
  autoTitle             Boolean  @default(true)
  contextLimit          Int      @default(20)
  usageWarningThreshold Int      @default(80)
  language              String   @default("en")
  customSystemPrompt    String?
  defaultDeckId         String?
  defaultAgentId        String?
  temperature           Float    @default(0.7)
  maxTokens             Int      @default(1000)
  accentColor           String   @default("#6366f1")
  dailyStudyGoal        Int      @default(20)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Deck {
  id        String      @id @default(cuid())
  name      String
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  cards     Flashcard[]
  createdAt DateTime    @default(now())
}

model Flashcard {
  id          String   @id @default(cuid())
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId      String
  front       String
  back        String
  interval    Int      @default(1)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())
  createdAt   DateTime @default(now())
}
